# Aplicação
APP_NAME=Comandas_API

# Conexão Spring Boot (Definida de forma direta)
DB_URL=jdbc:postgresql://localhost:5432/comandas?sslmode=disable
DB_USER=postgres
DB_PASS=12233445
DB_DRIVER=org.postgresql.Driver

# JPA / Hibernate
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_DDL=update
JPA_SHOW_SQL=true

# Flyway
FLYWAY_ENABLED=true
FLYWAY_LOCATIONS=classpath:db/migration

# Servidor Web
SERVER_PORT=8081

# Segurança Token
JWT_SECRET=Gin+Campari+Vermute+Gelo+Laranja